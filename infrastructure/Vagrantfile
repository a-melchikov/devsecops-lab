# -*- mode: ruby -*-
# vi: set ft=ruby :

VM_IP = "192.168.56.10"

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202508.03.0"
  config.vm.box_check_update = false

  config.vm.hostname = "devsecops-vm"

  config.vm.network "private_network",
    ip: VM_IP,
    libvirt__network_name: "devsecops-lab-private",
    libvirt__forward_mode: "none",
    libvirt__dhcp_enabled: false

  config.vm.network "forwarded_port",
    guest: 8080,
    host: 8080,
    host_ip: "127.0.0.1"

  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "libvirt" do |lv|
    lv.uri = "qemu:///system"
    lv.memory = 2048
    lv.cpus = 2
  end

  config.vm.provision "shell", name: "docker", inline: <<-SHELL
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y docker.io docker-buildx curl

    usermod -aG docker vagrant

    mkdir -p /etc/docker
    printf '%s\n' '{"insecure-registries":["#{VM_IP}:5000"]}' > /etc/docker/daemon.json

    systemctl enable docker
    systemctl restart docker
  SHELL
end
